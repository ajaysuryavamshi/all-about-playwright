{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "katalon:headed": "npx playwright test tests/katalon/appointment.spec.ts --headed",
    "katalon:chromium": "npx playwright test tests/katalon/appointment.spec.ts --project=chromium",
    "katalon:ui": "npx playwright test tests/katalon/appointment.spec.ts --ui",
    "katalon:debug": "npx playwright test tests/katalon/appointment.spec.ts --debug",
    "katalon:trace": "npx playwright test tests/katalon/appointment.spec.ts --project=chromium --trace on",
    "katalon:tag": "npx playwright test tests/katalon/appointment.spec.ts --grep @appointment",
    "report": "npx playwright show-report",
    "allure:report": "allure generate --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6"
  }
}
